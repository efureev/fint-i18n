{
  "name": "@feugene/fint-i18n",
  "version": "0.6.0",
  "description": "Lightweight Vue 3 i18n library with lazy-loading blocks and template caching",
  "author": "Fureev Eugene<https://feugene.org>",
  "license": "MIT",
  "homepage": "https://github.com/efureev/fint-i18n#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/efureev/fint-i18n.git"
  },
  "bugs": {
    "url": "https://github.com/efureev/fint-i18n/issues"
  },
  "keywords": [
    "vue",
    "i18n",
    "localization",
    "lazy-loading",
    "vue3",
    "translation"
  ],
  "type": "module",
  "files": [
    "dist",
    "scripts/check-messages.mjs",
    "scripts/codemod-plural-forms.mjs",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/types/core/index.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./vue": {
      "types": "./dist/types/vue/index.d.ts",
      "import": "./dist/vue.js",
      "default": "./dist/vue.js"
    },
    "./vue/global-types": {
      "types": "./dist/types/vue/global-types.d.ts",
      "import": "./dist/vue-global-types.js",
      "default": "./dist/vue-global-types.js"
    },
    "./plugins": {
      "types": "./dist/types/plugins/index.d.ts",
      "import": "./dist/plugins.js",
      "default": "./dist/plugins.js"
    }
  },
  "sideEffects": false,
  "peerDependencies": {
    "vue": "^3.5.32"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.1.0",
    "@codecov/vite-plugin": "^1.9.1",
    "@iconify-json/lucide": "^1.2.101",
    "@types/node": "^25.5.2",
    "@unocss/eslint-plugin": "^66.6.8",
    "@unocss/reset": "^66.6.8",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.3",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.2.0",
    "globals": "^17.4.0",
    "jsdom": "^29.0.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "^6.0.2",
    "unocss": "^66.6.8",
    "vite": "^8.0.5",
    "vitest": "^4.1.3",
    "vue": "^3.5.32",
    "vue-tsc": "^3.2.6"
  },
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "playground": "vite --config playground/vite.config.ts",
    "playground:build": "vite build --config playground/vite.config.ts",
    "build:analyze": "ANALYZE=true vite build && vue-tsc -p tsconfig.build.json",
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "prepublishOnly": "yarn build",
    "bench": "mkdir -p dist/analysis && vitest bench --run --config vitest.config.ts --environment node --outputJson dist/analysis/bench-results.json bench/",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "yarn test:coverage:package && yarn test:coverage:playground",
    "test:coverage:package": "vitest run --coverage",
    "test:coverage:playground": "vitest run --config playground/vitest.config.ts --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "size": "yarn build && node scripts/check-size.mjs",
    "size:check": "node scripts/check-size.mjs",
    "codemod:plurals": "node scripts/codemod-plural-forms.mjs",
    "playground:ssr": "node playground-ssr/server.mjs",
    "playground:ssr:build": "vite build --config playground-ssr/vite.config.ts --outDir dist/client --ssrManifest && vite build --config playground-ssr/vite.config.ts --outDir dist/server --ssr src/entry-server.ts",
    "playground:ssr:prod": "node playground-ssr/server.mjs --prod",
    "check:messages": "node scripts/check-messages.mjs playground/src/i18n/locales --source playground/src --allow fallback.enOnly --allow fallback.ruOnly --allow common.menu --allow runtime.hello --allow flaky.message",
    "size:consumer": "node scripts/consumer-size.mjs"
  },
  "bin": {
    "fint-i18n-check-messages": "./scripts/check-messages.mjs",
    "fint-i18n-codemod-plurals": "./scripts/codemod-plural-forms.mjs"
  }
}
